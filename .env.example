# ===========================================
# Redirx - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This single root .env is used by the backend (Flask API + Worker).
# Frontend env vars live in frontend/.env (VITE_* prefix).
#
# DEPLOYMENT NOTE:
#   On Render, set these as env vars on each service separately.
#   See the tables below for which vars each service needs.
#
# ┌─────────────────────────────────┬─────────┬────────┐
# │ Variable                        │ API     │ Worker │
# ├─────────────────────────────────┼─────────┼────────┤
# │ SUPABASE_URL                    │ ✓ req   │ ✓ req  │
# │ SUPABASE_KEY                    │ ✓ req   │ ✓ req  │
# │ DATABASE_URL                    │         │ ✓ req  │
# │ OPENAI_API_KEY                  │         │ ✓ req  │
# │ RESEND_API_KEY                  │ ✓ req   │ ✓ req  │
# │ APP_BASE_URL                    │ ✓ req   │ ✓ req  │
# │ STRIPE_SECRET_KEY               │ ✓ req   │ ✓ req  │
# │ STRIPE_WEBHOOK_SECRET           │ ✓ req   │        │
# │ STRIPE_PRICE_ID_*  (all 3)     │ ✓ req   │ ✓ req  │
# │ CORS_ORIGINS                    │ ✓ req   │        │
# │ FLASK_ENV / FLASK_DEBUG         │ optional│        │
# │ WORKER_*  (4 vars)             │         │ optional│
# │ SCRAPER_MAX_CONCURRENT_*        │         │ optional│
# │ SITE_AUDITOR_*                  │ optional│        │
# └─────────────────────────────────┴─────────┴────────┘

# --- Supabase (required: API + Worker) ---
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "service_role" key for the backend (NOT the anon key)
SUPABASE_KEY=your-service-role-key-here

# --- PostgreSQL Direct Connection (required: Worker only) ---
# Get from: Supabase Dashboard → Connect → Direct connection or Session Mode
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# IMPORTANT: Must use Direct or Session Mode (NOT Transaction Mode) for LISTEN/NOTIFY
DATABASE_URL=postgresql://postgres:your-password@db.xxxxx.supabase.co:5432/postgres

# --- OpenAI (required: Worker only) ---
# Get from: https://platform.openai.com/api-keys
# Used by the pipeline for generating embeddings. Not needed by the API.
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Embedding Config (optional: Worker only, defaults shown) ---
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# --- Matching Thresholds (optional: Worker only, defaults shown) ---
# HIGH_CONFIDENCE_THRESHOLD=0.85
# MEDIUM_CONFIDENCE_THRESHOLD=0.7
# AMBIGUITY_GAP_THRESHOLD=0.1

# --- Content Job URL Caps (optional: API + Worker, defaults shown) ---
# Hard caps are enforced before queueing and again in the worker fail-fast path.
# CONTENT_MAX_URLS_PER_SITE=5000
# CONTENT_MAX_OLD_URLS=5000
# CONTENT_MAX_NEW_URLS=5000

# --- Deep Match Preview Funnel (optional: API + Worker, defaults shown) ---
# ENABLE_DEEP_MATCH_PREVIEW=false
# PREVIEW_MAX_OLD_CANDIDATES=12
# PREVIEW_MAX_NEW_URLS_FULL_SCAN=300
# PREVIEW_MAX_NEW_URLS_CAPPED=180
# PREVIEW_FREE_ROWS=2
# PREVIEW_MAX_JOBS_PER_USER_PER_DAY=2
# DEEP_MATCH_BACKGROUND_MIN_PAGES=50

# --- Worker Configuration (optional: Worker only, defaults shown) ---
# WORKER_LEASE_DURATION=600       # Lease timeout in seconds (default: 10 min)
# WORKER_MAX_CONCURRENT=1         # Max concurrent jobs (default: 1)
# WORKER_FALLBACK_INTERVAL=60     # Fallback poll interval in seconds
# WORKER_MAX_ATTEMPTS=5           # Max retries before permanent failure
# SCRAPER_MAX_CONCURRENT_TOTAL=12      # Per-job total scrape fanout (bounded 1-64)
# SCRAPER_MAX_CONCURRENT_PER_SITE=8    # Per old/new site scrape fanout (bounded 1-32)

# --- Demo Site Auditor (optional: API only, defaults shown) ---
# SITE_AUDITOR_MAX_URLS=50                 # Max discovered URLs to audit (bounded 1-200)
# SITE_AUDITOR_SCRAPE_MAX_CONCURRENT=10    # Concurrent page scrapes per audit (bounded 1-30)

# --- Stripe (required: API + Worker) ---
# Get from: https://dashboard.stripe.com/apikeys
# API uses checkout/webhooks; worker uses usage metering for agency overages.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Webhook secret for verifying Stripe webhook signatures.
# For LOCAL DEV: Run `stripe listen` once, copy the whsec_... secret it prints.
#   dev.py will auto-start `stripe listen --forward-to localhost:5001/api/billing/webhook`.
# For PRODUCTION: Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# MCP pivot sandbox checkout (API only; separate from legacy Stripe settings).
# MCP_STRIPE_TEST_SECRET_KEY=sk_test_your-sandbox-secret-key
# /api/v2/billing/stripe-test/webhook signing secret:
# MCP_STRIPE_TEST_WEBHOOK_SECRET=whsec_payment-destination-secret
# /api/v2/billing/stripe-test/subscriptions/webhook signing secret:
# MCP_STRIPE_TEST_SUBSCRIPTION_WEBHOOK_SECRET=whsec_subscription-destination-secret
# Omit the subscription secret only when one local CLI listener signs both routes.
# An explicitly empty subscription secret fails closed instead of falling back.
# MCP_STRIPE_TEST_STUDIO_PRICE_ID=price_studio-test-monthly
# MCP_STRIPE_TEST_MONITORING_PRICE_ID=price_monitoring-test-monthly
# MCP_CHECKOUT_COMPANION_ORIGIN=https://app.redirx.dev

# Stripe Price IDs (required: API + Worker)
# Create products in Stripe Dashboard, then copy price IDs here.
STRIPE_PRICE_ID_AGENCY_MONTHLY=price_xxx
STRIPE_PRICE_ID_AGENCY_ANNUAL=price_xxx
STRIPE_PRICE_ID_AGENCY_OVERAGE=price_xxx

# Stripe Meter event name (required for agency overage billing)
# Create a Billing Meter in Stripe Dashboard, then copy the event name here.
STRIPE_METER_EVENT_NAME=

# --- Email / Resend (required: API + Worker) ---
# Get from: https://resend.com/api-keys
# Domain redirx.dev is verified on Resend.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=Dylon @ RedirX <noreply@redirx.dev>
# Base URL for links in emails (dashboard, unsubscribe, etc.)
APP_BASE_URL=http://localhost:3000

# --- Crawl Politeness / Per-Host Rate Limiting (API + Worker) ---
# Global per-host token bucket in Postgres (table host_buckets, migration 025).
# Shared state matters: N workers each honoring a local semaphore still produce
# N times the rate at the origin. Real sites already 429 us without this.
#
# Point this at the Supabase TRANSACTION pooler (port 6543), NOT the direct
# 5432 connection, so scaling workers cannot exhaust connections. Transaction
# mode is safe here because the limiter uses only ON CONFLICT row locks
# (transaction-scoped); it never takes a session-scoped advisory lock, which
# silently does nothing in transaction mode. Falls back to DATABASE_URL.
# CRAWL_LIMITER_DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres
# CRAWL_LIMITER_POOL_SIZE=4
#
# Set false to disable pacing entirely (not recommended outside local dev).
# If the limiter database is unreachable the crawler FAILS OPEN — a brief
# unthrottled window beats a dead pipeline — and logs once per host.
# CRAWL_POLITENESS_ENABLED=true
# CRAWL_BURST_CAPACITY=3        # bucket depth per host
# CRAWL_DEFAULT_RATE=1          # steady-state req/s per host; AIMD adapts from here
# CRAWL_MAX_RATE=4              # ceiling for additive increase on clean responses
# CRAWL_MIN_RATE=0.1            # floor for multiplicative decrease on 429/503
# CRAWL_RATE_INCREMENT=0.1      # additive step per clean response
# CRAWL_BREAKER_THRESHOLD=3     # consecutive 403/429/503 before halting a host
# CRAWL_BREAKER_COOLDOWN=900    # seconds a tripped host stays paused
# CRAWL_MAX_ACQUIRE_WAIT=30     # max seconds a single fetch waits for a token

# --- SSRF Protection (optional: API + Worker) ---
# Extra CIDRs to deny for all server-side fetches, comma-separated. RFC1918,
# loopback, link-local (incl. 169.254.169.254 cloud metadata), unique-local
# IPv6, CGNAT, and reserved ranges are ALWAYS denied and need no config.
# Set this to your own VPC/private subnets so a compromised input cannot
# reach internal services.
# SSRF_DENY_CIDRS=10.100.0.0/16,192.0.2.0/24

# --- Domain URL Discovery (optional: API only, defaults shown) ---
# Caps for the paste-two-domains ingestion path (sitemap/CMS-API/crawl).
# DISCOVERY_MAX_URLS_FREE=1000
# DISCOVERY_MAX_URLS_PAID=5000
# Overall per-domain scan budget in seconds. Keep below the gunicorn worker
# timeout (default 30s) since discovery runs inside the request.
# DISCOVERY_TIME_BUDGET_SECONDS=20

# --- Google Search Console Integration (optional: API only) ---
# Create an OAuth client (type: Web application) in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Enable the "Google Search Console API" for the project, and add the redirect
# URI below to the OAuth client's authorized redirect URIs.
# Without these vars the GSC endpoints return "not configured" and the UI hides
# the Connect button.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Must exactly match an authorized redirect URI on the OAuth client.
# Production: https://your-backend.onrender.com/api/gsc/callback
GSC_OAUTH_REDIRECT_URI=http://localhost:5001/api/gsc/callback
# Agent consent reuses this registered callback when the pivot is enabled.
# Optional separate callback, only after registering it with the Google client:
# GSC_AGENT_REDIRECT_URI=https://your-backend.onrender.com/api/v2/connections/search-console/callback
# Secret for signing OAuth state tokens (defaults to SUPABASE_KEY if unset).
# GSC_STATE_SECRET=
# How many days of Search Analytics data to pull (default: 90).
# GSC_LOOKBACK_DAYS=90

# --- Local Dev Settings (API only) ---
# CORS: set to * for local dev. In production (Render), set to your frontend URL.
CORS_ORIGINS=*
FLASK_ENV=development
FLASK_DEBUG=1

# --- Content Fetch Ladder (optional: Worker, defaults shown) ---
# Deep Match reads page content cheapest-source-first: platform API
# (WordPress/Shopify bulk) -> live fetch -> Wayback archive. Measured on a real
# WordPress site: 3 API calls replaced 147 per-page requests, and the API body
# is cleaner input (no nav/footer boilerplate).
# CONTENT_LADDER_ENABLED=true    # false restores straight per-page scraping
# CONTENT_MIN_USABLE_TEXT=200    # below this, fall through to the next tier

# URL-first Jev MVP. Worker must be upgraded BEFORE enabling new API admissions.
JEV_MVP_ENABLED=false
# Global UTC daily maximum, not per account. Hard cap: $1 incl URL embeddings.
JEV_DAILY_BUDGET_USD=1

# October 2026 billing: apply 063/064 and verify sandbox flow before owner activation.
# Independent of historical MCP_STRIPE_TEST_* and deferred migrations 059-061.
REDIRX_CURRENT_BILLING_ENABLED=false
REDIRX_STRIPE_MODE=test
# REDIRX_STRIPE_SECRET_KEY=sk_test_sandbox-key
# REDIRX_STRIPE_WEBHOOK_SECRET=whsec_current-billing-destination
# REDIRX_STRIPE_ACCOUNT_ID=acct_sandbox
# Test prices must mirror the catalog; live mode defaults to the verified IDs in current_pricing.py.
# REDIRX_STRIPE_PAYG_PRICE_ID=price_sandbox_payg
# REDIRX_STRIPE_STUDIO_PRICE_ID=price_sandbox_studio
# REDIRX_STRIPE_AGENCY_PRICE_ID=price_sandbox_agency
# REDIRX_STRIPE_ADDITIONAL_URLS_PRICE_ID=price_sandbox_extra
# Portal configuration: cancellation at period end, subscription changes disabled.
# REDIRX_STRIPE_PORTAL_CONFIGURATION_ID=bpc_current_catalog
# MCP_CHECKOUT_COMPANION_ORIGIN=https://app.redirx.dev
TYPESAFE_API_KEY=
